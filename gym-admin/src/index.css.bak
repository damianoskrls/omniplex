*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --hs-primary: #76C043;
  --hs-primary-hover: #65a838;
  --hs-primary-dark: #4A8D2C;
  --hs-primary-darker: #2d5016;
  --hs-primary-soft: rgba(118, 192, 67, 0.18);
  --hs-primary-ring: rgba(118, 192, 67, 0.28);
  --hs-sidebar-from: #2d5016;
  --hs-sidebar-to: #1a3310;
  --hs-text: #1e293b;
  --hs-text-muted: #64748b;
  --hs-surface: #f4f7f0;
}

body {
  font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
  background: var(--hs-surface);
  background-image:
    radial-gradient(ellipse 80% 60% at 10% 0%, rgba(118, 192, 67, 0.12), transparent 55%),
    radial-gradient(ellipse 70% 50% at 90% 10%, rgba(74, 141, 44, 0.08), transparent 50%);
  color: var(--hs-text);
  min-height: 100vh;
}

a { text-decoration: none; color: inherit; }

input, select, textarea, button {
  font-family: inherit;
  font-size: 0.875rem;
}

/* ── Layout ── */
.layout { display: flex; height: 100vh; overflow: hidden; }

.sidebar {
  width: 248px;
  background: linear-gradient(180deg, var(--hs-sidebar-from) 0%, var(--hs-sidebar-to) 100%);
  color: #e8f5e0;
  display: flex;
  flex-direction: column;
  padding: 0;
  flex-shrink: 0;
  border-right: 1px solid rgba(255,255,255,0.06);
  box-shadow: 8px 0 32px rgba(15, 23, 42, 0.08);
  height: 100vh;
  position: sticky;
  top: 0;
  overflow-y: auto;
}

.brand-logo {
  padding: 16px 16px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.brand-logo--login {
  padding: 0 0 12px;
  border-bottom: none;
  margin-bottom: 4px;
}

.brand-logo__banner {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 10px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.2);
}

.brand-logo__banner--sidebar {
  max-width: 210px;
}

.brand-logo--kiosk {
  padding: 0;
  border-bottom: none;
  margin: 0 auto 12px;
}

.brand-logo__banner--kiosk {
  max-width: min(360px, 92vw);
  margin: 0 auto;
  border-radius: 14px;
  box-shadow: 0 8px 28px rgba(0,0,0,0.35);
}

.brand-logo__banner--login {
  max-width: min(300px, 100%);
  margin: 0 auto;
}

.sidebar-business {
  padding: 0 20px 12px;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.65);
}

.sidebar-business__role {
  margin-top: 4px;
  color: rgba(255,255,255,0.85);
  font-weight: 600;
}

.sidebar-trainer-identity {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
  padding: 4px 20px 16px;
}

.sidebar-trainer-identity .sidebar-business {
  padding: 0;
  width: 100%;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.topbar-trainer-avatar {
  display: none;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  border-radius: 50%;
  line-height: 0;
}

.topbar-trainer-avatar:focus-visible {
  outline: 2px solid var(--hs-primary);
  outline-offset: 2px;
}

.sidebar-nav { flex: 1; padding: 12px 0; overflow-y: auto; }

.sidebar-nav a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  margin: 2px 10px;
  border-radius: 12px;
  font-size: 0.875rem;
  color: rgba(255,255,255,0.72);
  transition: all 0.15s;
  border-left: none;
}

.sidebar-nav a:hover { background: rgba(255,255,255,0.08); color: #fff; }
.sidebar-nav a.active { background: var(--hs-primary-soft); color: #fff; box-shadow: inset 0 0 0 1px rgba(143, 212, 86, 0.45); }

.sidebar-nav-link__label { flex: 1; min-width: 0; }

.sidebar-nav-badge {
  margin-left: auto;
  background: #ef4444;
  color: #fff;
  border-radius: 999px;
  font-size: 0.65rem;
  min-width: 18px;
  height: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 5px;
  font-weight: 700;
  flex-shrink: 0;
}

.sidebar-subnav-link .sidebar-nav-badge {
  margin-left: auto;
}

.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

.topbar {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(226, 232, 240, 0.9);
  padding: 16px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.mobile-menu-btn {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #fff;
  color: var(--hs-primary-dark);
  cursor: pointer;
  flex-shrink: 0;
}

.sidebar-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 199;
}

.sidebar-backdrop--visible { display: block; }

.topbar--modern { min-height: 72px; position: relative; z-index: 120; }
.topbar-title { font-size: 1.2rem; font-weight: 700; color: #0f172a; letter-spacing: -0.02em; }
.topbar-sub { font-size: 0.78rem; color: #64748b; margin-top: 2px; }

.content { flex: 1; padding: 24px; overflow-y: auto; }
.content--modern { padding: 28px; }

/* ── Cards ── */
.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20px;
  border: 1px solid rgba(226, 232, 240, 0.9);
  padding: 22px;
  box-shadow: 0 10px 40px rgba(15, 23, 42, 0.05);
}

.card--flush { padding: 0; overflow: hidden; }

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.card-title { font-size: 1rem; font-weight: 600; }

/* ── Stat cards ── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 18px;
  border: 1px solid rgba(226, 232, 240, 0.9);
  padding: 20px;
  box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);
  transition: transform 0.15s, box-shadow 0.15s;
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(15, 23, 42, 0.08);
}

.stat-label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
.stat-value { font-size: 1.75rem; font-weight: 700; margin-top: 4px; }

/* ── Table ── */
.table-wrap { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
th { text-align: left; padding: 10px 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; border-bottom: 1px solid #e2e8f0; }
td { padding: 12px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
tr:last-child td { border-bottom: none; }
tr:hover td { background: #f8fafc; }

/* ── Badges ── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 99px;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
}

.badge-green  { background: #dcfce7; color: #166534; }
.badge-red    { background: #fee2e2; color: #991b1b; }
.badge-blue   { background: #dbeafe; color: #1e40af; }
.badge-yellow { background: #fef9c3; color: #854d0e; }
.badge-gray   { background: #f1f5f9; color: #475569; }

/* ── Buttons ── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  border: none;
  transition: all 0.15s;
}

.btn-primary   { background: var(--hs-primary); color: #fff; box-shadow: 0 2px 8px rgba(118, 192, 67, 0.35); }
.btn-primary:hover { background: var(--hs-primary-hover); }
.btn-secondary { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
.btn-secondary:hover { background: #e2e8f0; }
.btn-danger    { background: #fee2e2; color: #991b1b; }
.btn-danger:hover { background: #fecaca; }
.btn-sm { padding: 5px 10px; font-size: 0.8rem; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }

/* ── Forms ── */
.form-group { margin-bottom: 16px; }
.form-label { display: block; font-size: 0.8rem; font-weight: 500; color: #475569; margin-bottom: 6px; }

.form-input, .form-select {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  font-size: 0.875rem;
  color: #1e293b;
  background: #fff;
  transition: border-color 0.15s;
}

.form-input:focus, .form-select:focus {
  outline: none;
  border-color: var(--hs-primary);
  box-shadow: 0 0 0 3px var(--hs-primary-ring);
}

.form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

/* ── Toggle switch ── */
.toggle {
  position: relative;
  display: inline-block;
  width: 40px;
  height: 22px;
}

.toggle input { display: none; }

.toggle-slider {
  position: absolute;
  inset: 0;
  background: #cbd5e1;
  border-radius: 99px;
  cursor: pointer;
  transition: 0.2s;
}

.toggle-slider::before {
  content: '';
  position: absolute;
  width: 16px;
  height: 16px;
  background: #fff;
  border-radius: 50%;
  left: 3px;
  top: 3px;
  transition: 0.2s;
}

.toggle input:checked + .toggle-slider { background: var(--hs-primary); }
.toggle input:checked + .toggle-slider::before { transform: translateX(18px); }

/* ── Color picker ── */
.color-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.color-preview {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  border: 1px solid #e2e8f0;
  flex-shrink: 0;
}

/* ── Modal ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 16px;
}

.modal {
  background: #fff;
  border-radius: 16px;
  padding: 24px;
  width: 100%;
  max-width: 560px;
  max-height: 90vh;
  overflow-y: auto;
}

.modal-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 20px; }
.modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }

/* ── Login page ── */
.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px 16px;
  background: linear-gradient(135deg, var(--hs-sidebar-from) 0%, var(--hs-primary-dark) 50%, var(--hs-primary) 100%);
}

.login-card {
  background: #fff;
  border-radius: 16px;
  padding: clamp(24px, 5vw, 40px);
  width: 100%;
  max-width: 420px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.25);
}

.login-logo {
  font-size: 1.5rem;
  font-weight: 800;
  text-align: center;
  margin-bottom: 8px;
}

.login-logo span { color: var(--hs-primary); }
.login-subtitle { text-align: center; color: #64748b; font-size: 0.875rem; margin-bottom: 28px; }

/* ── Color swatch ── */
.swatch { display: inline-block; width: 14px; height: 14px; border-radius: 3px; border: 1px solid rgba(0,0,0,0.1); margin-right: 6px; vertical-align: middle; }

/* ── Misc ── */
.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; gap: 12px; flex-wrap: wrap; }
.page-title { font-size: 1.25rem; font-weight: 700; }
.text-muted { color: #64748b; font-size: 0.8rem; }
.mt-4 { margin-top: 16px; }
.gap-2 { gap: 8px; }
.flex { display: flex; }
.items-center { align-items: center; }
.loading { text-align: center; padding: 48px; color: #64748b; }

/* ── Grouped bookings ── */
.bk-grouped { display: flex; flex-direction: column; gap: 20px; }

.bk-group-tabs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.bk-group-tab {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
  background: #fff;
  color: #64748b;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}

.bk-group-tab:hover { border-color: #c7d2fe; color: #4338ca; }
.bk-group-tab.active {
  background: linear-gradient(135deg, var(--hs-primary), var(--hs-primary-dark));
  border-color: transparent;
  color: #fff;
  box-shadow: 0 8px 20px rgba(118, 192, 67, 0.25);
}

.bk-filter-scroll {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: thin;
}

.bk-filter-chip {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 180px;
  padding: 12px 14px;
  border-radius: 14px;
  border: 2px solid #e2e8f0;
  background: #fff;
  text-align: left;
  cursor: pointer;
  transition: all 0.15s;
  flex-shrink: 0;
}

.bk-filter-chip:hover { border-color: #c7d2fe; transform: translateY(-1px); }
.bk-filter-chip.active {
  border-color: var(--hs-primary);
  background: #eef2ff;
  box-shadow: 0 8px 24px rgba(118, 192, 67, 0.12);
}
.bk-filter-chip.empty { opacity: 0.72; }

.bk-filter-chip-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--hs-primary), #818cf8);
  color: #fff;
}

.bk-filter-chip-label { font-weight: 700; font-size: 0.9rem; color: #1e293b; }
.bk-filter-chip-sub { font-size: 0.75rem; color: #64748b; margin-top: 2px; }

.bk-hero {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 20px 22px;
  border-radius: 16px;
  background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
  border: 1px solid #c7d2fe;
}

.bk-hero-title { font-size: 1.35rem; font-weight: 800; color: #1e293b; }
.bk-hero-sub { color: #64748b; margin-top: 4px; }

.bk-group-section {
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
}

.bk-group-header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.bk-group-title { font-size: 1.05rem; font-weight: 800; color: #1e293b; }
.bk-group-sub { font-size: 0.8rem; color: #64748b; margin-top: 2px; }

.bk-group-list { display: flex; flex-direction: column; }

.bk-slot-block {
  border-bottom: 1px solid #e2e8f0;
}

.bk-slot-block:last-child { border-bottom: none; }

.bk-slot-block.has-location {
  border-left: 3px solid #3b82f6;
}

.bk-slot-time-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  min-width: 72px;
}

.bk-booking-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  font-weight: 700;
  font-size: 0.95rem;
  color: #0f172a;
}

.bk-slot-header {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 14px 18px 10px;
  background: #f8fafc;
  border-bottom: 1px solid #f1f5f9;
}

.bk-slot-header-main { flex: 1; min-width: 0; }

.bk-slot-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.bk-slot-count {
  font-size: 0.78rem;
  color: #64748b;
  margin-top: 4px;
  font-weight: 600;
}

.bk-slot-participants {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  padding: 12px 18px 14px;
}

.bk-participant-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  max-width: 100%;
  padding: 4px 8px 4px 4px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid #e2e8f0;
  transition: border-color 0.12s, box-shadow 0.12s, background 0.12s;
}

.bk-participant-chip:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
}

.bk-participant-chip__name {
  font-weight: 700;
  font-size: 0.82rem;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 140px;
}

.bk-participant-chip__badge {
  padding: 2px 6px;
  font-size: 0.65rem;
  line-height: 1.2;
}

.bk-participant-chip__meta {
  font-size: 0.72rem;
  color: #14b8a6;
  font-weight: 600;
  white-space: nowrap;
}

.bk-participant-chip__actions {
  display: none;
  align-items: center;
  gap: 4px;
  margin-left: 2px;
}

.bk-participant-chip:hover .bk-participant-chip__actions {
  display: inline-flex;
}

.bk-participant-chip__btn {
  width: 26px;
  height: 26px;
  min-width: 26px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.bk-participant-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 18px 12px 84px;
  border-bottom: 1px solid #f8fafc;
}

.bk-participant-row:last-child { border-bottom: none; }

.bk-participant-main { flex: 1; min-width: 0; }

.bk-booking-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  border-bottom: 1px solid #f1f5f9;
}

.bk-booking-row:last-child { border-bottom: none; }
.bk-booking-time {
  min-width: 52px;
  font-weight: 800;
  font-size: 1rem;
  color: #4338ca;
}
.bk-booking-main { flex: 1; min-width: 0; }
.bk-booking-meta { font-size: 0.8rem; color: #64748b; margin-top: 2px; }

.bk-waitlist-section {
  padding: 18px;
  border-radius: 16px;
  background: #fff7ed;
  border: 1px solid #fed7aa;
}

.bk-waitlist-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid #ffedd5;
}

.bk-waitlist-row:last-child { border-bottom: none; }
.bk-empty {
  text-align: center;
  padding: 48px 20px;
  color: #64748b;
  border: 1px dashed #cbd5e1;
  border-radius: 16px;
}

/* ── Create booking modal ── */
.cb-modal {
  max-width: 680px;
  width: calc(100vw - 32px);
  max-height: 92vh;
  overflow-y: auto;
  padding: 0;
}

.cb-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 24px 0;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 2;
}

.cb-modal-title { font-size: 1.25rem; font-weight: 800; color: #1e293b; }
.cb-modal-sub { font-size: 0.85rem; color: #64748b; margin-top: 4px; }

.cb-icon-btn {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.cb-form { padding: 18px 24px 24px; display: flex; flex-direction: column; gap: 22px; }

.cb-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 4px 0 8px;
}

.cb-step {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 0;
}

.cb-step:not(:last-child)::after {
  content: '';
  flex: 1;
  height: 2px;
  background: #e2e8f0;
  margin-left: 8px;
  border-radius: 1px;
}

.cb-step.done:not(:last-child)::after,
.cb-step.active:not(:last-child)::after {
  background: rgba(118, 192, 67, 0.45);
}

.cb-step-num {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  font-weight: 800;
  flex-shrink: 0;
  background: #f1f5f9;
  color: #94a3b8;
  border: 2px solid #e2e8f0;
}

.cb-step.active .cb-step-num {
  background: var(--hs-primary);
  color: #fff;
  border-color: var(--hs-primary);
}

.cb-step.done .cb-step-num {
  background: #ecfdf5;
  color: var(--hs-primary);
  border-color: rgba(118, 192, 67, 0.5);
}

.cb-step-label {
  font-size: 0.78rem;
  font-weight: 700;
  color: #94a3b8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cb-step.active .cb-step-label,
.cb-step.done .cb-step-label {
  color: #334155;
}

.cb-selected-client-compact {
  margin-bottom: 0;
}

.cb-package-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 6px;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 999px;
}

.cb-package-badge.trial {
  background: #fef9c3;
  color: #a16207;
}

.cb-package-badge.package {
  background: #ecfdf5;
  color: #15803d;
}

.cb-service-visual.small {
  width: 44px;
  height: 44px;
  min-width: 44px;
  border-radius: 10px;
}

.cb-bookable-empty-inline {
  padding: 20px 16px;
  text-align: center;
  gap: 12px;
}

.cb-bookable-empty-inline .cb-bookable-empty-text {
  margin-bottom: 12px;
}

.cb-client-item.trial-pending:not(.disabled) {
  background: #fffbeb;
  border-left: 3px solid #fbbf24;
}

.cb-trial-blocks {
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: stretch;
}

.cb-trial-blocks.compact {
  margin-bottom: 4px;
}

.cb-trial-block {
  display: flex;
  gap: 14px;
  padding: 16px;
  border-radius: 14px;
  background: #fffbeb;
  border: 1px solid #fde68a;
}

.cb-trial-block.compact {
  padding: 10px 12px;
  font-size: 0.82rem;
  color: #92400e;
  align-items: flex-start;
}

.cb-trial-block-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: #fef3c7;
  color: #b45309;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cb-trial-block-title {
  font-weight: 800;
  color: #92400e;
  margin-bottom: 6px;
}

.cb-trial-block-text {
  margin: 0;
  font-size: 0.88rem;
  color: #78350f;
  line-height: 1.45;
}

.cb-trial-block-when {
  margin: 8px 0 0;
  font-size: 0.82rem;
  font-weight: 700;
  color: #b45309;
}

.cb-section-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #64748b;
  margin-bottom: 12px;
}

.cb-section { display: flex; flex-direction: column; }

.cb-search {
  position: relative;
  display: flex;
  align-items: center;
}

.cb-search-icon {
  position: absolute;
  left: 14px;
  color: #94a3b8;
  pointer-events: none;
}

.cb-search-input {
  width: 100%;
  padding: 12px 14px 12px 42px;
  border-radius: 12px;
  border: 2px solid #e2e8f0;
  background: #f8fafc;
  font-size: 0.95rem;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.cb-search-input:focus {
  outline: none;
  border-color: var(--hs-primary);
  box-shadow: 0 0 0 3px rgba(118, 192, 67, 0.12);
  background: #fff;
}

.cb-client-list {
  margin-top: 8px;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  overflow: hidden;
  max-height: 240px;
  overflow-y: auto;
  background: #fff;
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
}

.cb-client-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: none;
  border-bottom: 1px solid #f1f5f9;
  background: #fff;
  text-align: left;
  cursor: pointer;
  transition: background 0.12s;
}

.cb-client-item:hover { background: #f8fafc; }
.cb-client-item.active { background: #eef2ff; }
.cb-client-item.disabled {
  opacity: 0.55;
  cursor: not-allowed;
}
.cb-client-item.disabled:hover { background: transparent; }
.cb-client-item:last-child { border-bottom: none; }

.cb-client-item-name { font-weight: 700; color: #1e293b; }
.cb-client-item-meta { font-size: 0.8rem; color: #64748b; margin-top: 2px; }
.cb-check { color: var(--hs-primary); margin-left: auto; }

.cb-selected-client {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 16px;
  border-radius: 14px;
  background: linear-gradient(135deg, #f0fdf4, #f8fafc);
  border: 2px solid rgba(118, 192, 67, 0.35);
}

.cb-selected-info { flex: 1; min-width: 0; }
.cb-selected-name { font-weight: 800; color: #1e293b; }
.cb-selected-meta { font-size: 0.82rem; color: #64748b; margin-top: 2px; }
.cb-selected-check { color: var(--hs-primary); flex-shrink: 0; }

.cb-text-btn {
  border: none;
  background: none;
  color: var(--hs-primary);
  font-weight: 700;
  font-size: 0.85rem;
  cursor: pointer;
}

.cb-service-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

@media (max-width: 560px) {
  .cb-service-grid { grid-template-columns: 1fr; }
}

.cb-service-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 14px;
  border: 2px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  text-align: left;
  transition: all 0.15s;
  position: relative;
}

.cb-service-card:hover {
  border-color: #c7d2fe;
  transform: translateY(-1px);
}

.cb-service-card.active {
  border-color: var(--hs-primary);
  background: #eef2ff;
  box-shadow: 0 8px 24px rgba(118, 192, 67, 0.12);
}

.cb-service-visual {
  width: 52px;
  height: 52px;
  border-radius: 12px;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cb-service-visual.has-icon {
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
}

.cb-service-visual.has-photo {
  background: #1e293b;
}

.cb-service-photo { width: 100%; height: 100%; object-fit: cover; }

.cb-service-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4338ca;
}

.cb-service-icon-wrap img {
  filter: brightness(0) saturate(100%) invert(32%) sepia(89%) saturate(1945%) hue-rotate(226deg) brightness(93%) contrast(91%);
}

.cb-service-text { flex: 1; min-width: 0; }
.cb-service-name { font-weight: 700; font-size: 0.92rem; color: #1e293b; }
.cb-service-meta { font-size: 0.75rem; color: #64748b; margin-top: 2px; }

.cb-radio {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid #cbd5e1;
  flex-shrink: 0;
  position: relative;
}

.cb-radio.on {
  border-color: var(--hs-primary);
  background: var(--hs-primary);
  box-shadow: inset 0 0 0 3px #fff;
}

.cb-date-input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  border: 2px solid #e2e8f0;
  background: #f8fafc;
  font-size: 0.95rem;
}

.cb-date-input:focus {
  outline: none;
  border-color: var(--hs-primary);
  box-shadow: 0 0 0 3px rgba(118, 192, 67, 0.12);
}

.cb-day-row {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 4px 0 6px;
  -webkit-overflow-scrolling: touch;
}

.cb-day-pill {
  flex: 0 0 auto;
  min-width: 72px;
  padding: 10px 8px;
  border-radius: 12px;
  border: 2px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  transition: all 0.12s;
}

.cb-day-pill:hover:not(:disabled) { border-color: #c7d2fe; }
.cb-day-pill.active {
  border-color: var(--hs-primary);
  background: var(--hs-primary);
  color: #fff;
  box-shadow: 0 6px 18px rgba(118, 192, 67, 0.25);
}
.cb-day-pill.active .cb-day-week { color: rgba(255,255,255,0.85); }
.cb-day-pill:disabled {
  cursor: not-allowed;
  opacity: 0.38;
  background: #f8fafc;
}
.cb-day-main { font-weight: 800; font-size: 0.85rem; }
.cb-day-week { font-size: 0.68rem; color: #64748b; font-weight: 600; }

.cb-time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.cb-location-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 10px;
}

.cb-location-pill {
  padding: 12px 16px;
  border-radius: 12px;
  border: 2px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  font-weight: 700;
  font-size: 0.92rem;
  color: #334155;
  text-align: center;
  transition: all 0.12s;
}

.cb-location-pill:hover {
  border-color: #c7d2fe;
  background: #f8fafc;
}

.cb-location-pill.active {
  border-color: var(--hs-primary);
  background: var(--hs-primary);
  color: #fff;
  box-shadow: 0 6px 18px rgba(118, 192, 67, 0.25);
}

.cb-location-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 999px;
  background: #ecfdf5;
  border: 1px solid rgba(118, 192, 67, 0.35);
  color: #166534;
  font-size: 0.85rem;
  font-weight: 700;
  width: fit-content;
}

.cb-time-pill {
  min-width: 88px;
  padding: 10px 12px;
  border-radius: 12px;
  border: 2px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  transition: all 0.12s;
}

.cb-time-pill:hover:not(:disabled) { border-color: #c7d2fe; }
.cb-time-pill.active {
  border-color: var(--hs-primary);
  background: var(--hs-primary);
  color: #fff;
  box-shadow: 0 6px 18px rgba(118, 192, 67, 0.25);
}
.cb-time-pill.active .cb-time-sub { color: rgba(255,255,255,0.85); }
.cb-time-pill.full:not(.active) { opacity: 0.55; }
.cb-time-pill:disabled { cursor: not-allowed; opacity: 0.4; }

.cb-time-main { font-weight: 800; font-size: 1rem; }
.cb-time-sub { font-size: 0.7rem; color: #64748b; }
.cb-time-badge {
  font-size: 0.65rem;
  font-weight: 700;
  color: #ea580c;
  background: #ffedd5;
  padding: 2px 6px;
  border-radius: 999px;
  margin-top: 2px;
}
.cb-time-pill.active .cb-time-badge { background: rgba(255,255,255,0.2); color: #fff; }

.cb-staff-row {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding-bottom: 4px;
}

.cb-staff-pick {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  min-width: 110px;
}

.cb-staff-pick.excluded .cb-staff-card {
  opacity: 0.45;
  filter: grayscale(0.4);
}

.cb-staff-check-label {
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.cb-staff-check-label input {
  width: 16px;
  height: 16px;
  accent-color: var(--hs-primary);
  cursor: pointer;
}

.cb-staff-card {
  min-width: 110px;
  padding: 14px 12px;
  border-radius: 14px;
  border: 2px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  position: relative;
  transition: all 0.12s;
  flex-shrink: 0;
}

.cb-staff-card:hover { border-color: #c7d2fe; }
.cb-staff-card.active {
  border-color: var(--hs-primary);
  background: #eef2ff;
  box-shadow: 0 8px 20px rgba(118, 192, 67, 0.12);
}

.cb-staff-name { font-weight: 700; font-size: 0.82rem; text-align: center; color: #1e293b; }
.cb-staff-role { font-size: 0.72rem; color: #64748b; text-align: center; }
.cb-staff-check {
  position: absolute;
  top: 8px;
  right: 8px;
  color: var(--hs-primary);
}

.cb-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.cb-option {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 999px;
  border: 2px solid #e2e8f0;
  background: #fff;
  color: #64748b;
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.12s;
}

.cb-option.on {
  border-color: var(--hs-primary);
  background: #eef2ff;
  color: #4338ca;
}

.cb-summary {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border-radius: 12px;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #166534;
  font-size: 0.85rem;
  font-weight: 600;
}

.cb-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 8px;
  border-top: 1px solid #f1f5f9;
}

.cb-empty-inline {
  padding: 16px;
  text-align: center;
  color: #64748b;
  font-size: 0.9rem;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
}

.cb-bookable-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 32px 24px 28px;
  text-align: center;
}

.cb-bookable-empty-icon {
  color: #94a3b8;
}

.cb-bookable-empty-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: #1e293b;
}

.cb-bookable-empty-text {
  font-size: 0.9rem;
  color: #64748b;
  max-width: 360px;
  line-height: 1.5;
}

.cb-bookable-hint {
  margin-top: 8px;
  font-size: 0.78rem;
  color: #64748b;
  line-height: 1.4;
}

.cb-bookable-banner {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  margin-bottom: 4px;
  border-radius: 12px;
  background: #fff7ed;
  border: 1px solid #fed7aa;
  color: #9a3412;
  font-size: 0.85rem;
  line-height: 1.4;
}

.cb-bookable-banner-link {
  margin-left: auto;
  font-weight: 700;
  color: #c2410c;
  white-space: nowrap;
}

/* ── Subscription / payments modal ── */
.sub-membership-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.sub-membership-chip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  padding: 10px 14px;
  border-radius: 12px;
  border: 2px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  color: #334155;
  transition: all 0.12s;
}

.sub-membership-chip:hover { border-color: #c7d2fe; }
.sub-membership-chip.active {
  border-color: var(--hs-primary);
  background: #eef2ff;
  color: #4338ca;
}
.sub-membership-chip.expired { opacity: 0.7; }
.sub-membership-dates { font-size: 0.72rem; font-weight: 500; color: #64748b; }
.sub-membership-chip.active .sub-membership-dates { color: var(--hs-primary); }

.sub-option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

@media (max-width: 560px) {
  .sub-option-grid { grid-template-columns: 1fr; }
}

.sub-option-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 14px;
  border: 2px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  text-align: left;
  transition: all 0.15s;
  position: relative;
}

.sub-option-card:hover {
  border-color: #c7d2fe;
  transform: translateY(-1px);
}

.sub-option-card.active {
  border-color: var(--hs-primary);
  background: #eef2ff;
  box-shadow: 0 8px 24px rgba(118, 192, 67, 0.12);
}

.sub-option-card.is-blocked {
  opacity: 0.72;
  border-style: dashed;
  border-color: #fcd34d;
  background: #fffbeb;
}

.sub-option-card.is-blocked:hover {
  border-color: #f59e0b;
}

.sub-option-text {
  flex: 1;
  min-width: 0;
}

.sub-option-service {
  font-weight: 700;
  font-size: 0.88rem;
  color: #1e293b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub-option-plan {
  font-size: 0.8rem;
  color: #475569;
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub-option-meta {
  font-size: 0.72rem;
  color: #64748b;
  margin-top: 4px;
}

.sub-option-card .cb-radio { flex-shrink: 0; }

.sub-type-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

@media (max-width: 560px) {
  .sub-type-row { grid-template-columns: 1fr; }
}

.sub-type-card {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px;
  border-radius: 12px;
  border: 2px solid #e2e8f0;
  background: #fff;
  cursor: pointer;
  text-align: left;
  color: #475569;
  transition: all 0.12s;
}

.sub-type-card:hover { border-color: #c7d2fe; }
.sub-type-card.active {
  border-color: var(--hs-primary);
  background: var(--hs-primary);
  color: #fff;
  box-shadow: 0 8px 22px rgba(118, 192, 67, 0.22);
}
.sub-type-card.active .sub-type-sub { color: rgba(255,255,255,0.85); }

.sub-type-label { font-weight: 700; font-size: 0.9rem; }
.sub-type-sub { font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }

.sub-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-size: 0.88rem;
  color: #475569;
}

.sub-summary-card {
  margin: 12px 0;
  padding: 14px;
  border-radius: 12px;
  background: linear-gradient(135deg, #eef2ff, #f8fafc);
  border: 1px solid #c7d2fe;
}

.sub-summary-total { margin-top: 8px; font-weight: 800; font-size: 1.1rem; color: #4338ca; }

/* ── Payments overview page ── */
.pay-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 12px;
  margin-bottom: 20px;
}

.pay-kpi {
  padding: 16px;
  border-radius: 14px;
  background: #fff;
  border: 1px solid #e2e8f0;
}

.pay-kpi-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; }
.pay-kpi-value { font-size: 1.5rem; font-weight: 800; color: #1e293b; margin-top: 6px; }
.pay-kpi.warn .pay-kpi-value { color: #ea580c; }
.pay-kpi.danger .pay-kpi-value { color: #dc2626; }
.pay-kpi.ok .pay-kpi-value { color: #16a34a; }

.pay-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
  align-items: center;
}

.pay-filter-pill {
  padding: 8px 14px;
  border-radius: 999px;
  border: 2px solid #e2e8f0;
  background: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  color: #475569;
  transition: all 0.12s;
}

.pay-filter-pill:hover { border-color: #c7d2fe; }
.pay-filter-pill.active {
  border-color: var(--hs-primary);
  background: var(--hs-primary);
  color: #fff;
}

.pay-client-cell {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pay-service-thumb {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
}

.pay-service-thumb img { width: 100%; height: 100%; object-fit: cover; }

.pay-view-toggle {
  display: flex;
  gap: 6px;
  margin-left: auto;
}

.pay-clients-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pay-client-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  transition: box-shadow 0.15s;
}

.pay-client-card.has-balance {
  border-color: #fed7aa;
  box-shadow: 0 4px 16px rgba(234, 88, 12, 0.06);
}

.pay-client-card-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  flex-wrap: wrap;
}

.pay-client-toggle {
  border: none;
  background: #f8fafc;
  border-radius: 8px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #64748b;
  flex-shrink: 0;
}

.pay-client-card-info {
  flex: 1;
  min-width: 180px;
}

.pay-client-name {
  font-weight: 800;
  font-size: 1rem;
  color: #1e293b;
  text-decoration: none;
}

.pay-client-name:hover { color: var(--hs-primary); }

.pay-client-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.pay-stat {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 999px;
}

.pay-stat.ok { background: #dcfce7; color: #166534; }
.pay-stat.warn { background: #ffedd5; color: #c2410c; }
.pay-stat.danger { background: #fee2e2; color: #991b1b; }
.pay-stat.muted { background: #f1f5f9; color: #64748b; }

.pay-client-card-body {
  border-top: 1px solid #f1f5f9;
  padding: 8px 16px 12px 60px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.pay-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid #f8fafc;
  flex-wrap: wrap;
}

.pay-item-row:last-child { border-bottom: none; }

.pay-item-row.compact .pay-client-cell { flex: 1; min-width: 200px; }

.pay-item-amounts {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  font-size: 0.88rem;
}

.pay-item-balance {
  color: #ea580c;
  font-weight: 700;
  font-size: 0.82rem;
}

.pay-item-actions {
  display: flex;
  gap: 4px;
}

@media (max-width: 640px) {
  .pay-client-card-body { padding-left: 16px; }
  .pay-view-toggle { margin-left: 0; width: 100%; }
}

/* ── Kiosk QR display ── */
@keyframes kioskSlideDown {
  from { opacity: 0; transform: translateX(-50%) translateY(-12px); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

@media print {
  body { background: #fff !important; }
  .no-print { display: none !important; }
  .kiosk-page {
    background: #fff !important;
    color: #0f172a !important;
    min-height: auto !important;
    padding: 24px !important;
  }
  .kiosk-print-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    page-break-inside: avoid;
  }
  .kiosk-page .kiosk-qr-wrap {
    box-shadow: none !important;
    border: 2px solid #e2e8f0;
  }
  .kiosk-page [style*="color: #94a3b8"],
  .kiosk-page [style*="color: #64748b"] {
    color: #475569 !important;
  }
}

/* ── Modern nutrition & dashboard ── */
.layout--nutrition .sidebar { background: linear-gradient(180deg, #1e3a14 0%, var(--hs-sidebar-to) 100%); }
.layout--trainer .sidebar { background: linear-gradient(180deg, #254418 0%, var(--hs-sidebar-to) 100%); }
.layout--trainer .sidebar-group__title { color: #b8e986; }
.layout--nutrition .sidebar-nav a.active {
  background: var(--hs-primary-soft);
  box-shadow: inset 0 0 0 1px rgba(143, 212, 86, 0.45);
}

.dashboard-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
}

.dashboard-kpi {
  position: relative;
  overflow: hidden;
  padding: 22px;
  border-radius: 20px;
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(226,232,240,0.9);
  box-shadow: 0 10px 40px rgba(15,23,42,0.05);
  text-decoration: none;
  color: inherit;
  transition: transform 0.15s, box-shadow 0.15s;
}

.dashboard-kpi:hover { transform: translateY(-2px); box-shadow: 0 16px 40px rgba(15,23,42,0.08); }
.dashboard-kpi--warn { background: linear-gradient(135deg, #fffbeb, #fff); border-color: #fde68a; }
.dashboard-kpi__label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; }
.dashboard-kpi__value { font-size: 2rem; font-weight: 800; margin-top: 8px; letter-spacing: -0.03em; color: #0f172a; }
.dashboard-kpi__glow {
  position: absolute;
  right: -20px;
  top: -20px;
  width: 88px;
  height: 88px;
  border-radius: 50%;
  opacity: 0.35;
  filter: blur(2px);
}

/* ── Dashboard widgets ── */
.dash-widgets {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 24px;
}

.dash-widget {
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(226,232,240,0.9);
  border-radius: 20px;
  padding: 22px;
  box-shadow: 0 10px 40px rgba(15,23,42,0.05);
  animation: dash-fade-in 0.45s ease both;
}

.dash-widget--wide { grid-column: 1 / -1; }

.dash-widget__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.dash-widget__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 1rem;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.02em;
}

.dash-widget__sub {
  font-size: 0.8rem;
  color: #64748b;
  margin-top: 4px;
}

.dash-empty {
  text-align: center;
  padding: 32px 16px;
  color: #94a3b8;
  font-size: 0.9rem;
}

.dash-alert {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
  padding: 12px 16px;
  border-radius: 14px;
  background: linear-gradient(135deg, #fffbeb, #fff);
  border: 1px solid #fde68a;
  color: #92400e;
  font-size: 0.875rem;
  font-weight: 600;
  transition: transform 0.15s, box-shadow 0.15s;
}

.dash-alert:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(245,158,11,0.12);
}

.dash-alert svg:last-child { margin-left: auto; opacity: 0.5; }

/* Trial widget */
.dash-trial-widget {
  margin-top: 20px;
  background: linear-gradient(135deg, #f0fdf4, #fff);
  border: 2px solid #bbf7d0;
  border-radius: 16px;
  padding: 16px 20px;
}
.dash-trial-widget__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
  font-size: 0.9rem;
  color: #15803d;
  margin-bottom: 12px;
}
.dash-trial-widget__empty { color: #94a3b8; font-size: 0.875rem; margin: 0; }
.dash-trial-list { display: flex; flex-direction: column; gap: 8px; }
.dash-trial-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  background: #fff;
  border: 1px solid #d1fae5;
  border-radius: 10px;
  padding: 8px 12px;
}
.dash-trial-row__info { display: flex; flex-direction: column; gap: 2px; }
.dash-trial-row__name { font-weight: 700; font-size: 0.875rem; color: #0f172a; }
.dash-trial-row__meta { font-size: 0.8rem; color: #64748b; }

/* Timeline */
.dash-timeline { display: flex; flex-direction: column; gap: 8px; }

.dash-timeline__slot {
  display: grid;
  grid-template-columns: 56px 10px 1fr;
  gap: 12px;
  align-items: start;
  padding: 12px 14px;
  border-radius: 14px;
  background: #fff;
  border: 1px solid #e2e8f0;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.dash-timeline__slot--now {
  border-color: rgba(118, 192, 67, 0.45);
  background: linear-gradient(135deg, rgba(118, 192, 67, 0.08), #fff);
  box-shadow: 0 4px 16px rgba(118, 192, 67, 0.12);
}

.dash-timeline__slot--past { opacity: 0.65; }

.dash-slot-participants {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}

.dash-slot-person {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 10px 4px 4px;
  border-radius: 999px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  text-decoration: none;
  color: inherit;
  transition: background 0.12s, border-color 0.12s;
  max-width: 100%;
}

.dash-slot-person:hover {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.dash-slot-person__name {
  font-weight: 700;
  font-size: 0.82rem;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 130px;
}

.dash-slot-person .badge {
  font-size: 0.62rem;
  padding: 2px 6px;
}

.dash-timeline__item {
  display: grid;
  grid-template-columns: 72px 12px 1fr auto;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid transparent;
  transition: background 0.15s, border-color 0.15s, transform 0.15s;
  animation: dash-slide-in 0.4s ease both;
}

.dash-timeline__item:hover {
  background: #fff;
  border-color: #e2e8f0;
  transform: translateX(4px);
}

.dash-timeline__item--now {
  background: linear-gradient(135deg, rgba(118,192,67,0.12), #fff);
  border-color: rgba(118,192,67,0.35);
  box-shadow: 0 4px 20px rgba(118,192,67,0.12);
}

.dash-timeline__item--past { opacity: 0.65; }

.dash-timeline__time {
  display: flex;
  flex-direction: column;
  font-size: 0.82rem;
  font-weight: 700;
  color: #0f172a;
}

.dash-timeline__duration { font-size: 0.72rem; font-weight: 500; color: #94a3b8; }

.dash-timeline__dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  box-shadow: 0 0 0 3px rgba(255,255,255,0.9);
}

.dash-timeline__name { font-weight: 700; font-size: 0.9rem; color: #0f172a; }
.dash-timeline__meta { font-size: 0.78rem; color: #64748b; margin-top: 2px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }

.dash-location-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  border-radius: 999px;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  color: #1d4ed8;
  font-size: 0.72rem;
  font-weight: 700;
  white-space: nowrap;
}

.dash-location-badge--sm {
  padding: 2px 8px;
  font-size: 0.68rem;
}

.bk-location-filter {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px 6px 12px;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #64748b;
}

.bk-location-filter-label {
  font-size: 0.8rem;
  font-weight: 700;
  white-space: nowrap;
}

.bk-location-filter-select {
  width: auto;
  min-width: 160px;
  border: none;
  background: transparent;
  padding: 4px 8px;
  font-weight: 600;
}

.bk-active-filter {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 10px 14px;
  margin-bottom: 14px;
  border-radius: 12px;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  color: #1e40af;
  font-size: 0.88rem;
}

.bk-location-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: 999px;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  color: #1d4ed8;
  font-size: 0.72rem;
  font-weight: 700;
  vertical-align: middle;
  flex-shrink: 0;
}

.bk-location-badge.prominent {
  font-size: 0.78rem;
  padding: 4px 10px;
  background: #dbeafe;
  border-color: #93c5fd;
}

/* Bar chart */
.dash-bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 6px;
  height: 180px;
  padding-top: 8px;
}

.dash-bar-chart__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  min-width: 0;
}

.dash-bar-chart__value {
  font-size: 0.7rem;
  font-weight: 700;
  color: #64748b;
  height: 16px;
  margin-bottom: 4px;
}

.dash-bar-chart__track {
  flex: 1;
  width: 100%;
  max-width: 36px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.dash-bar-chart__bar {
  width: 100%;
  border-radius: 8px 8px 4px 4px;
  background: linear-gradient(180deg, #86efac, var(--hs-primary));
  min-height: 0;
  animation: dash-bar-grow 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  transform-origin: bottom;
}

.dash-bar-chart__bar--today {
  background: linear-gradient(180deg, #a3e635, var(--hs-primary-dark));
  box-shadow: 0 4px 16px rgba(118,192,67,0.35);
}

.dash-bar-chart__label {
  font-size: 0.65rem;
  color: #94a3b8;
  margin-top: 8px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.dash-bar-chart__label--today { color: var(--hs-primary-dark); font-weight: 700; }

/* Donut */
.dash-donut {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20px;
  justify-content: center;
}

.dash-donut__svg { flex-shrink: 0; }

.dash-donut__slice {
  animation: dash-donut-draw 0.9s ease both;
  stroke-linecap: butt;
}

.dash-donut__legend { flex: 1; min-width: 140px; }

.dash-donut__legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 0;
  font-size: 0.82rem;
  animation: dash-fade-in 0.4s ease both;
}

.dash-donut__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.dash-donut__name { flex: 1; font-weight: 600; color: #334155; }
.dash-donut__pct { color: #64748b; font-size: 0.78rem; }

/* Client list */
.dash-client-list { display: flex; flex-direction: column; gap: 6px; }

.dash-client-list__item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 12px;
  transition: background 0.15s, transform 0.15s;
  animation: dash-slide-in 0.35s ease both;
}

.dash-client-list__item:hover {
  background: #f8fafc;
  transform: translateX(3px);
}

.dash-client-list__avatar {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 0.95rem;
  flex-shrink: 0;
}

.dash-client-list__info { flex: 1; min-width: 0; }
.dash-client-list__name { font-weight: 700; font-size: 0.88rem; color: #0f172a; }
.dash-client-list__meta {
  font-size: 0.75rem;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dash-client-list__date {
  font-size: 0.72rem;
  color: #94a3b8;
  flex-shrink: 0;
}

@keyframes dash-fade-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes dash-slide-in {
  from { opacity: 0; transform: translateX(-8px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes dash-bar-grow {
  from { transform: scaleY(0); opacity: 0.5; }
  to { transform: scaleY(1); opacity: 1; }
}

@keyframes dash-donut-draw {
  from { stroke-dashoffset: 400; opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 960px) {
  .dash-widgets { grid-template-columns: 1fr; gap: 14px; }
  .dash-widget--wide { grid-column: auto; }
  .dash-timeline__item {
    grid-template-columns: 64px 10px 1fr;
    grid-template-rows: auto auto;
  }
  .dash-timeline__item .badge { grid-column: 2 / -1; justify-self: start; margin-left: 22px; }
}

@media (max-width: 520px) {
  .dash-bar-chart { height: 150px; }
  .dash-donut { flex-direction: column; }
}

/* ── Reports page ─────────────────────────────────────────── */
.reports-page { display: grid; gap: 20px; }
.reports-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
.reports-filters { padding: 16px 18px; }
.reports-filters__row {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px;
}
.reports-filters label { display: grid; gap: 6px; font-size: 0.78rem; font-weight: 600; color: #64748b; }
.reports-filters input,
.reports-filters select {
  width: 100%;
  padding: 8px 10px;
  border: 1px solid var(--hs-border, #e2e8f0);
  border-radius: 10px;
  font-size: 0.88rem;
  background: #fff;
}
.reports-filters__presets { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.reports-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 4px;
  background: #f8fafc;
  border-radius: 14px;
  border: 1px solid #eef2f7;
}
.reports-tab {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 14px;
  border: none;
  border-radius: 10px;
  background: transparent;
  color: #64748b;
  font-weight: 600;
  font-size: 0.88rem;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}
.reports-tab:hover { background: #fff; color: #334155; }
.reports-tab--active { background: #fff; color: var(--hs-primary-dark, #4A8D2C); box-shadow: 0 1px 4px rgba(15,23,42,0.06); }
.reports-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 12px;
}
.reports-kpi {
  background: #fff;
  border: 1px solid #eef2f7;
  border-radius: 16px;
  padding: 16px;
  position: relative;
  overflow: hidden;
}
.reports-kpi::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--kpi-color, #76C043);
}
.reports-kpi__icon { color: var(--kpi-color, #76C043); margin-bottom: 8px; }
.reports-kpi__value { font-size: 1.75rem; font-weight: 800; color: #0f172a; line-height: 1; }
.reports-kpi__label { margin-top: 6px; font-size: 0.82rem; font-weight: 600; color: #334155; }
.reports-kpi__sub { margin-top: 4px; font-size: 0.72rem; color: #94a3b8; }
.reports-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}
.reports-grid--wide { grid-column: 1 / -1; }
.reports-grid--full { grid-column: 1 / -1; }
.reports-panel {
  background: #fff;
  border: 1px solid #eef2f7;
  border-radius: 18px;
  padding: 18px;
}
.reports-panel__head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}
.reports-panel__head h3 { margin: 0; font-size: 1rem; font-weight: 700; }
.reports-panel__icon { color: var(--hs-primary, #76C043); }
.reports-loading, .reports-empty { padding: 32px; text-align: center; color: #94a3b8; }
.reports-hbar-list { display: grid; gap: 10px; }
.reports-hbar-row {
  display: grid;
  grid-template-columns: minmax(90px, 1fr) 2fr auto;
  gap: 10px;
  align-items: center;
}
.reports-hbar-label {
  font-size: 0.82rem;
  font-weight: 600;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.reports-hbar-track {
  height: 10px;
  background: #f1f5f9;
  border-radius: 999px;
  overflow: hidden;
}
.reports-hbar-fill {
  height: 100%;
  border-radius: 999px;
  animation: reports-bar-grow 0.8s ease both;
  transform-origin: left center;
}
.reports-hbar-value { font-size: 0.82rem; font-weight: 700; color: #475569; min-width: 28px; text-align: right; }
.reports-time-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}
.reports-time-card {
  display: grid;
  justify-items: center;
  gap: 6px;
  padding: 12px;
  background: #f8fafc;
  border-radius: 14px;
  text-align: center;
}
.reports-time-icon { font-size: 1.5rem; }
.reports-time-label { font-size: 0.72rem; font-weight: 600; color: #64748b; min-height: 2.4em; }
.reports-time-bar-track {
  width: 100%;
  height: 72px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.reports-time-bar-fill {
  width: 36px;
  background: linear-gradient(180deg, #86efac, #4A8D2C);
  border-radius: 8px 8px 4px 4px;
  animation: reports-bar-grow-v 0.9s ease both;
}
.reports-time-count { font-size: 1.4rem; font-weight: 800; color: #0f172a; }
.reports-time-sub { font-size: 0.72rem; color: #94a3b8; }
.reports-table-wrap { overflow-x: auto; }
.reports-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
.reports-table th,
.reports-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #f1f5f9; }
.reports-table th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: #94a3b8; font-weight: 700; }
.reports-table tbody tr:hover { background: #fafbfd; }
.reports-link {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  color: var(--hs-primary-dark, #4A8D2C);
  font-weight: 600;
  text-decoration: none;
}
.reports-link:hover { text-decoration: underline; }
.reports-pay-summary {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 12px;
}
.reports-pay-stat {
  background: #fff;
  border: 1px solid #eef2f7;
  border-radius: 14px;
  padding: 14px 16px;
  display: grid;
  gap: 8px;
}
.reports-pay-stat strong { font-size: 1.4rem; font-weight: 800; }
.reports-pay-stat--total strong { color: #dc2626; }
@keyframes reports-bar-grow {
  from { transform: scaleX(0); opacity: 0.4; }
  to { transform: scaleX(1); opacity: 1; }
}
@keyframes reports-bar-grow-v {
  from { height: 0; opacity: 0.4; }
  to { opacity: 1; }
}
@media (max-width: 900px) {
  .reports-grid { grid-template-columns: 1fr; }
  .reports-time-grid { grid-template-columns: 1fr; }
}

.nutrition-layout {
  display: grid;
  grid-template-columns: minmax(250px, 280px) 1fr;
  gap: 22px;
  align-items: start;
}

@media (max-width: 960px) {
  .nutrition-layout { grid-template-columns: 1fr; }
}

.nutrition-main { display: grid; gap: 20px; }

.nutrition-client-list__head {
  padding: 16px 18px;
  font-weight: 800;
  border-bottom: 1px solid #eef2f7;
  background: linear-gradient(180deg, #fafbfd, #fff);
}

.nutrition-client-item {
  display: block;
  width: 100%;
  text-align: left;
  padding: 14px 18px;
  border: none;
  border-bottom: 1px solid #f1f5f9;
  background: #fff;
  cursor: pointer;
  transition: background 0.12s;
}

.nutrition-client-item:hover { background: #f8fafc; }
.nutrition-client-item.active {
  background: linear-gradient(90deg, var(--hs-primary-soft), rgba(118, 192, 67, 0.04));
  box-shadow: inset 3px 0 0 var(--hs-primary);
}

.nutrition-client-item__name { font-weight: 700; color: #0f172a; }
.nutrition-client-item__meta { font-size: 0.8rem; color: #64748b; margin-top: 2px; }
.nutrition-client-list__foot { padding: 14px; border-top: 1px solid #eef2f7; background: #fafbfd; }

.nutrition-main--full { width: 100%; max-width: none; }

.sidebar-group { margin: 4px 12px 10px; }
.sidebar-group__title {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 10px; font-size: 0.8rem; font-weight: 700;
  color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em;
}
.sidebar-group--active .sidebar-group__title { color: #b8e986; }
.sidebar-group__items { display: flex; flex-direction: column; gap: 2px; }
.sidebar-subnav-link {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 10px 8px 28px; border-radius: 8px;
  color: #cbd5e1; font-size: 0.88rem; text-decoration: none;
}
.sidebar-subnav-link:hover { background: rgba(255,255,255,0.06); color: #f8fafc; }
.sidebar-subnav-link.active { background: var(--hs-primary-soft); color: #d9f99d; font-weight: 600; }

/* Accordion groups */
.sidebar-accordion { margin: 2px 8px; }
.sidebar-accordion__header {
  width: 100%; display: flex; align-items: center; justify-content: space-between;
  padding: 7px 10px; border-radius: 8px; border: none; background: none; cursor: pointer;
  color: #94a3b8; font-size: 0.75rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.05em;
  transition: background 0.15s, color 0.15s;
}
.sidebar-accordion__header:hover { background: rgba(255,255,255,0.05); color: #cbd5e1; }
.sidebar-accordion__header--active { color: #b8e986; }
.sidebar-accordion__title { flex: 1; text-align: left; }
.sidebar-accordion__chevron { transition: transform 0.2s; flex-shrink: 0; opacity: 0.7; }
.sidebar-accordion__chevron--open { transform: rotate(180deg); }
.sidebar-accordion__items { display: flex; flex-direction: column; gap: 1px; padding-bottom: 4px; }

.nutrition-hero-card {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(238,242,255,0.9));
}

.nutrition-hero-card__title { margin: 0; font-size: 1.35rem; letter-spacing: -0.02em; }

.program-editor-card { background: rgba(255,255,255,0.94); }
.program-editor-card__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
  flex-wrap: wrap;
  gap: 12px;
}

.program-toolbar {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 12px;
  padding: 12px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #eef2f7;
}

.modal--wide { max-width: 720px; width: 95%; }

.template-grid { display: grid; gap: 12px; }

.template-card {
  padding: 14px 16px;
  border-radius: 16px;
  border: 1px solid #e2e8f0;
  background: #fff;
  box-shadow: 0 6px 20px rgba(15,23,42,0.04);
}

.template-card--loss { border-color: #fecaca; background: linear-gradient(135deg, #fff, #fff5f5); }
.template-card--muscle { border-color: #bfdbfe; background: linear-gradient(135deg, #fff, #eff6ff); }
.template-card--med { border-color: #bbf7d0; background: linear-gradient(135deg, #fff, #f0fdf4); }
.template-card--veg { border-color: #fde68a; background: linear-gradient(135deg, #fff, #fffbeb); }

.template-card__top { display: flex; gap: 12px; align-items: flex-start; }
.template-card__icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  background: rgba(255,255,255,0.8);
  border: 1px solid rgba(0,0,0,0.05);
  flex-shrink: 0;
}

.template-card__badge {
  font-size: 0.68rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 3px 8px;
  border-radius: 999px;
  background: #0f172a;
  color: #fff;
}

.template-card__notes { font-size: 0.82rem; color: #64748b; margin-top: 4px; line-height: 1.4; }
.template-card__meta { font-size: 0.75rem; color: #94a3b8; margin-top: 6px; font-weight: 600; }
.template-card__actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 12px; }

.body-measurements-hero {
  background: linear-gradient(145deg, #121826 0%, #1a2235 55%, #151d2e 100%);
  color: #e2e8f0;
  padding: 22px 24px;
  border-radius: 20px 20px 0 0;
}

.body-measurements-hero__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 18px;
}

.body-measurements-hero__title { font-size: 1.1rem; font-weight: 800; color: #fff; }
.body-measurements-hero__sub { font-size: 0.82rem; color: #94a3b8; margin-top: 4px; }

.body-measurements-badge {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  color: #cbd5e1;
  white-space: nowrap;
}

.body-measurements-hero__body {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 16px;
  align-items: center;
}

@media (max-width: 720px) {
  .body-measurements-hero__body { grid-template-columns: 1fr; }
}

.body-measurements-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.body-measurements-stat {
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
}

.body-measurements-stat__label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: #94a3b8; font-weight: 700; }
.body-measurements-stat__value { font-size: 1.25rem; font-weight: 800; color: #fff; margin-top: 4px; }
.body-measurements-stat__value.accent { color: #b8e986; }
.body-measurements-stat__value.teal { color: #86efac; }
.body-measurements-stat__target { font-size: 0.72rem; color: #64748b; margin-top: 2px; }

.body-measurements-figure {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140px;
}

.body-measurements-figure__img {
  display: block;
  object-fit: contain;
  max-width: 100%;
  filter: drop-shadow(0 12px 24px rgba(0,0,0,0.35));
}

.measurements-charts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
  padding: 20px 22px 0;
}

.glass-inset {
  padding: 14px 16px;
  border-radius: 16px;
  background: #f8fafc;
  border: 1px solid #eef2f7;
}

.measurements-form-section {
  padding: 20px 22px 22px;
  border-top: 1px solid #eef2f7;
  margin-top: 4px;
}

/* ── Mobile & responsive ── */
@media (max-width: 900px) {
  .mobile-menu-btn { display: inline-flex; }
  .topbar-trainer-avatar { display: inline-flex; }

  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 200;
    transform: translateX(-105%);
    transition: transform 0.25s ease;
    width: min(280px, 88vw);
    max-width: 100%;
  }

  .sidebar.sidebar--open { transform: translateX(0); }

  .topbar { padding: 12px 16px; min-height: 60px; }
  .topbar--modern { min-height: 60px; }
  .topbar-title { font-size: 1.05rem; }
  .topbar-sub { font-size: 0.72rem; }

  .content,
  .content--modern { padding: 16px; }

  .page-title { font-size: 1.1rem; }
  .form-grid-2 { grid-template-columns: 1fr; }

  .card { border-radius: 14px; }

  table {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .modal { padding: 20px 16px; border-radius: 14px; }
  .modal--wide { width: 100%; max-width: none; }

  .dashboard-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .dashboard-kpi { padding: 16px; }
  .dashboard-kpi__value { font-size: 1.5rem; }

  .nutrition-layout { gap: 14px; }
  .measurements-charts-grid { grid-template-columns: 1fr; padding: 16px; }
  .body-measurements-hero { padding: 18px 16px; }
  .body-measurements-stats { grid-template-columns: 1fr 1fr; }

  .program-toolbar { padding: 10px; }
  .bk-group-tabs { gap: 6px; }
  .bk-group-tab { padding: 8px 12px; font-size: 0.82rem; }
}

@media (max-width: 520px) {
  .dashboard-kpi-grid { grid-template-columns: 1fr; }
  .body-measurements-stats { grid-template-columns: 1fr; }
  .btn { padding: 10px 14px; }
  .login-card { padding: 24px 18px; }
  .brand-logo__banner--login { max-width: 100%; }
  .topbar-meta { display: none; }
}

@media (hover: none) {
  .sidebar-nav a,
  .btn,
  .dashboard-kpi { -webkit-tap-highlight-color: transparent; }
}

/* ── Notification bell (portal, above all content) ── */
.notification-bell { position: relative; }

.notification-bell__btn { position: relative; }

.notification-bell__badge {
  position: absolute;
  top: -4px;
  right: -4px;
  background: #ef4444;
  color: #fff;
  border-radius: 10px;
  font-size: 0.65rem;
  min-width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
  font-weight: 700;
}

.notification-backdrop {
  position: fixed;
  inset: 0;
  z-index: 5000;
  background: transparent;
}

.notification-panel {
  position: fixed;
  z-index: 5001;
  max-height: min(420px, calc(100vh - 80px));
  overflow-y: auto;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  box-shadow: 0 16px 48px rgba(15, 23, 42, 0.18);
}

.notification-panel__head {
  padding: 12px 14px;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 1;
}

.notification-panel__empty { padding: 16px; }

.notification-item {
  display: block;
  width: 100%;
  text-align: left;
  padding: 12px 14px;
  border: none;
  border-bottom: 1px solid #f1f5f9;
  background: #fff;
  cursor: pointer;
  transition: background 0.12s;
}

.notification-item--unread { background: #f0fdf4; }
.notification-item--link:hover { background: #ecfccb; }
.notification-item__title { font-weight: 600; font-size: 0.88rem; color: #0f172a; }
.notification-item__body { font-size: 0.8rem; color: #64748b; margin-top: 4px; line-height: 1.4; }
.notification-item__meta {
  font-size: 0.72rem;
  color: #94a3b8;
  margin-top: 6px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.notification-item__hint {
  color: var(--hs-primary-dark);
  font-weight: 600;
}

/* Client bookings section */
.bk-client-search-wrap { position: relative; max-width: 420px; }
.bk-client-search {
  display: flex;
  align-items: center;
  position: relative;
}
.bk-client-search-icon {
  position: absolute;
  left: 12px;
  color: #94a3b8;
  pointer-events: none;
}
.bk-client-search-input {
  padding-left: 40px !important;
  padding-right: 36px !important;
  width: 100%;
}
.bk-client-search-clear {
  position: absolute;
  right: 8px;
  background: none;
  border: none;
  color: #94a3b8;
  cursor: pointer;
  padding: 4px;
  display: flex;
}
.bk-client-suggestions {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
  z-index: 20;
  overflow: hidden;
}
.bk-client-suggestion {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 10px 14px;
  border: none;
  background: none;
  cursor: pointer;
  text-align: left;
  font-size: 0.88rem;
}
.bk-client-suggestion:hover { background: #f8fafc; }
.bk-client-suggestion-name { font-weight: 600; color: #0f172a; }

.cb-bookings-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
@media (max-width: 768px) {
  .cb-bookings-split { grid-template-columns: 1fr; }
}
.cb-bookings-col-title {
  font-weight: 700;
  font-size: 0.88rem;
  color: #475569;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 2px solid #e2e8f0;
}
.cb-booking-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #f1f5f9;
  flex-wrap: wrap;
}
.cb-booking-row:last-child { border-bottom: none; }
.cb-booking-row-time {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  color: #64748b;
  margin-bottom: 4px;
}
.cb-booking-row-title { font-weight: 700; font-size: 0.92rem; color: #0f172a; }
.cb-booking-row-meta { font-size: 0.8rem; color: #64748b; margin-top: 2px; }
.cb-booking-row-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.cb-attendance-alert {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  background: #fffbeb;
  border: 1px solid #fde68a;
  border-radius: 10px;
  margin-bottom: 16px;
  font-size: 0.85rem;
  color: #92400e;
}

.sess-charts-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  justify-content: flex-start;
}
.sess-ring { text-align: center; }
.sess-ring-label {
  font-weight: 700;
  font-size: 0.88rem;
  color: #0f172a;
  margin-top: 6px;
}
.sess-ring-sub {
  font-size: 0.75rem;
  color: #64748b;
  margin-top: 2px;
}

/* ── Messages ── */
.messages-layout {
  display: grid;
  grid-template-columns: minmax(280px, 360px) 1fr;
  gap: 16px;
  min-height: calc(100vh - 140px);
}

.messages-sidebar,
.messages-chat {
  display: flex;
  flex-direction: column;
  min-height: 520px;
  max-height: calc(100vh - 140px);
}

.messages-sidebar__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 14px 16px;
  border-bottom: 1px solid #e2e8f0;
}

.messages-sidebar__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 0.95rem;
}

.messages-badge {
  background: #ef4444;
  color: #fff;
  border-radius: 999px;
  font-size: 0.7rem;
  min-width: 20px;
  height: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 6px;
  font-weight: 700;
}

.messages-search {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-bottom: 1px solid #f1f5f9;
  color: #94a3b8;
}

.messages-search input {
  border: none;
  outline: none;
  width: 100%;
  font-size: 0.88rem;
  background: transparent;
}

.messages-new {
  padding: 12px 14px;
  border-bottom: 1px solid #e2e8f0;
  background: #f8fafc;
}

.messages-new__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}

.messages-new__title {
  font-size: 0.82rem;
  font-weight: 700;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.messages-new__close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: none;
  border-radius: 8px;
  background: #e2e8f0;
  color: #475569;
  font-size: 1.25rem;
  line-height: 1;
  cursor: pointer;
  transition: background 0.12s, color 0.12s;
}

.messages-new__close:hover {
  background: #cbd5e1;
  color: #0f172a;
}

.messages-new__search {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  color: #94a3b8;
}

.messages-new__search:focus-within {
  border-color: #84cc16;
  box-shadow: 0 0 0 2px rgba(132, 204, 22, 0.15);
}

.messages-new__search input {
  border: none;
  outline: none;
  width: 100%;
  font-size: 0.88rem;
  background: transparent;
  color: #0f172a;
}

.messages-new__search input::placeholder {
  color: #94a3b8;
}

.messages-new-toggle--active {
  background: #ecfccb;
  border-color: #84cc16;
  color: #3f6212;
}

.messages-new__list {
  max-height: 200px;
  overflow-y: auto;
  margin-top: 8px;
}

.messages-thread-list {
  flex: 1;
  overflow-y: auto;
}

.messages-thread {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 12px 14px;
  border: none;
  border-bottom: 1px solid #f1f5f9;
  background: #fff;
  cursor: pointer;
  text-align: left;
  transition: background 0.12s;
}

.messages-thread:hover { background: #f8fafc; }
.messages-thread--active { background: #ecfccb; }

.messages-thread__meta { flex: 1; min-width: 0; }
.messages-thread__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.messages-thread__name {
  font-weight: 700;
  font-size: 0.9rem;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.messages-thread__preview {
  font-size: 0.8rem;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.messages-thread__time {
  font-size: 0.72rem;
  color: #94a3b8;
  flex-shrink: 0;
}

.messages-thread__unread {
  background: var(--hs-primary, #84cc16);
  color: #0f172a;
  border-radius: 999px;
  font-size: 0.68rem;
  min-width: 18px;
  height: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 5px;
  font-weight: 700;
  flex-shrink: 0;
}

.messages-empty {
  padding: 24px 16px;
  text-align: center;
  color: #94a3b8;
  font-size: 0.88rem;
  line-height: 1.5;
}

.messages-chat__empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: #94a3b8;
  padding: 32px;
}

.messages-chat__head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border-bottom: 1px solid #e2e8f0;
}

.messages-chat__name { font-weight: 700; font-size: 1rem; color: #0f172a; }
.messages-chat__sub { font-size: 0.8rem; color: #64748b; margin-top: 2px; }

.messages-chat__body {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: #f8fafc;
}

.messages-bubble {
  max-width: min(78%, 520px);
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 0.9rem;
  line-height: 1.45;
}

.messages-bubble--mine {
  align-self: flex-end;
  background: #ecfccb;
  border: 1px solid #bef264;
}

.messages-bubble--theirs {
  align-self: flex-start;
  background: #fff;
  border: 1px solid #e2e8f0;
}

.messages-bubble__sender {
  font-size: 0.72rem;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 4px;
}

.messages-bubble__time {
  font-size: 0.68rem;
  color: #94a3b8;
  margin-top: 6px;
  text-align: right;
}

.messages-compose {
  padding: 12px 16px 16px;
  border-top: 1px solid #e2e8f0;
  background: #fff;
}

.messages-emoji-panel {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 4px;
  padding: 8px;
  margin-bottom: 8px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  max-height: 140px;
  overflow-y: auto;
}

.messages-emoji-btn {
  border: none;
  background: transparent;
  font-size: 1.25rem;
  line-height: 1;
  padding: 6px;
  border-radius: 8px;
  cursor: pointer;
}

.messages-emoji-btn:hover {
  background: #ecfccb;
}

.messages-compose__tools {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-bottom: 2px;
}

.messages-compose__tool {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 10px;
  background: transparent;
  color: #64748b;
  cursor: pointer;
}

.messages-compose__tool:hover:not(:disabled) {
  background: #ecfccb;
  color: #4A8D2C;
}

.messages-compose__tool:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.message-body__text {
  white-space: pre-wrap;
  word-break: break-word;
}

.message-body__link {
  color: #4A8D2C;
  text-decoration: underline;
  word-break: break-all;
}

.message-body__image-btn {
  display: block;
  padding: 0;
  border: none;
  background: transparent;
  cursor: zoom-in;
  border-radius: 12px;
}

.message-body__image {
  display: block;
  max-width: min(100%, 280px);
  border-radius: 12px;
  margin-bottom: 6px;
  transition: opacity 0.15s;
}

.message-body__image-btn:hover .message-body__image {
  opacity: 0.92;
}

.message-body__expired {
  font-size: 0.82rem;
  color: #94a3b8;
  font-style: italic;
  margin-bottom: 6px;
}

.image-lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.92);
  backdrop-filter: blur(4px);
}

.image-lightbox__close {
  position: fixed;
  top: 20px;
  right: 20px;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  z-index: 10001;
}

.image-lightbox__close:hover {
  background: rgba(255, 255, 255, 0.2);
}

.image-lightbox__img {
  max-width: min(96vw, 1200px);
  max-height: 92vh;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
}

.message-body__youtube {
  margin: 6px 0;
}

.message-body__youtube iframe {
  width: min(100%, 280px);
  height: 158px;
  border: none;
  border-radius: 12px;
  background: #000;
}

.message-body__youtube .message-body__link {
  display: block;
  margin-top: 4px;
  font-size: 0.75rem;
}

.messages-compose__inner {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  padding: 6px 6px 6px 14px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
}

.messages-compose__inner:focus-within {
  border-color: #bef264;
  box-shadow: 0 0 0 3px rgba(118, 192, 67, 0.14);
  background: #fff;
}

.messages-compose__input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  resize: none;
  min-height: 28px;
  max-height: 128px;
  padding: 8px 0;
  font-size: 0.9rem;
  line-height: 1.45;
  font-family: inherit;
  color: #0f172a;
}

.messages-compose__input::placeholder {
  color: #94a3b8;
}

.messages-compose__send {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--hs-primary);
  color: #fff;
  cursor: pointer;
  transition: background 0.15s, opacity 0.15s, transform 0.1s;
  box-shadow: 0 2px 8px rgba(118, 192, 67, 0.35);
}

.messages-compose__send:hover:not(:disabled) {
  background: var(--hs-primary-hover);
  transform: translateY(-1px);
}

.messages-compose__send:active:not(:disabled) {
  transform: translateY(0);
}

.messages-compose__send:disabled {
  opacity: 0.42;
  cursor: not-allowed;
  box-shadow: none;
}

@media (max-width: 900px) {
  .messages-layout { grid-template-columns: 1fr; }
  .messages-sidebar,
  .messages-chat { max-height: none; min-height: 360px; }
}
