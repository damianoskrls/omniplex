<?xml version="1.0" encoding="utf-8"?>
<!-- Allows HTTP to local/dev API (same intent as iOS NSAllowsLocalNetworking). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
